{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skeletor",
  "version": "0.1.0",
  "identifier": "com.spacepanda.skeletor",
  "build": {
    "beforeDevCommand": "npm run dev-nolog",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "npm run build-nolog",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Skeletor",
        "width": 1600,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
