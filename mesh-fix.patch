+export function toBoneLocal(
+    wx: number,
+    wy: number,
+    pivotX: number,
+    pivotY: number,
+    angle: number,
+): { x: number; y: number } {
+    const c = Math.cos(angle);
+    const s = Math.sin(angle);
+    const dx = wx - pivotX;
+    const dy = wy - pivotY;
+    return { x: dx * c + dy * s, y: -dx * s + dy * c };
