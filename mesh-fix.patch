+    lx: number,
+    ly: number,
+    pivotX: number,
+    pivotY: number,
+    angle: number,
+): { x: number; y: number } {
+    const c = Math.cos(angle);
+    const s = Math.sin(angle);
+    return { x: pivotX + lx * c - ly * s, y: pivotY + lx * s + ly * c };
